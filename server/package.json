    "express": "^5.3.0",
    "graphql": "^16.15.0",
    "graphql-subscriptions": "^3.1.0",
    "graphql-ws": "^6.4.3",
    "simple-git": "^4.1.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-resolvers": "^7.0.1",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
